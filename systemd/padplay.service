[Unit]
Description=PadPlay — Android tablet as a second monitor
Documentation=https://github.com/anisharaz/padplay

# Needs a running Wayland compositor: the daemon creates (Hyprland, via
# hyprctl) or attaches to (niri, via evdi; labwc, via wlr-randr) a virtual
# output and connects to the compositor as a capture client.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/padplay
Restart=on-failure
RestartSec=5

# The daemon idles on `adb track-devices`, so it costs nothing while waiting
# and does not need to be socket-activated.

# SIGTERM unwinds the RAII guards that remove the virtual output and the adb
# forward. Give that time to finish, or the compositor is left with a
# phantom monitor after a stop.
KillSignal=SIGTERM
TimeoutStopSec=15

# hyprctl/niri msg/wlr-randr all need this to find the compositor instance.
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target
